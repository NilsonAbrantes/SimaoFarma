# Não coloque valores reais deste arquivo no Git.
DJANGO_SECRET_KEY=troque-por-uma-chave-segura
DJANGO_DEBUG=false

# Opção manual: copie a URI do Supabase em Connect > Transaction pooler.
# Para o runtime da Vercel, use preferencialmente a porta 6543.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-REGIAO.pooler.supabase.com:6543/postgres?sslmode=require

# A integração Supabase da Vercel normalmente cria estas duas variáveis.
# Não é necessário copiá-las manualmente quando a integração está conectada.
# POSTGRES_URL=postgresql://...
# POSTGRES_URL_NON_POOLING=postgresql://...

# Alias opcional aceito pela aplicação.
# SUPABASE_DATABASE_URL=postgresql://...

# Somente para domínio próprio, separados por vírgula.
DJANGO_ALLOWED_HOSTS=seudominio.com,www.seudominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://seudominio.com,https://www.seudominio.com
